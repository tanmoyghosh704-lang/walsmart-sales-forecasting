{
  "title": "M5 Forecasting API",
  "uid": "m5-forecasting",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by endpoint (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (handler)",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "{{handler}} p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total requests served",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(http_requests_total)" }]
    },
    {
      "id": 4,
      "title": "/predict request count",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "sum(http_requests_total{handler=\"/predict\"})" }]
    },
    {
      "id": 5,
      "title": "Drift score (mean KS statistic across features)",
      "description": "Last 300 /predict feature inputs (deque buffer) vs the reference distribution from the most recent dvc-tracked feature_engineering snapshot. Higher = more different from training data. See serving/app.py for methodology.",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "prediction_drift_score" }]
    },
    {
      "id": 6,
      "title": "Drift alert",
      "description": "1 if prediction_drift_score has exceeded DRIFT_KS_THRESHOLD (default 0.3), else 0.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [{ "expr": "prediction_drift_alert" }]
    },
    {
      "id": 7,
      "title": "Per-feature KS statistic",
      "description": "feature_drift_ks_statistic broken out per numeric feature -- shows which feature is driving the aggregate drift score.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "feature_drift_ks_statistic",
          "legendFormat": "{{feature}}"
        }
      ]
    }
  ]
}
