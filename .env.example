# Copy this file to .env (already gitignored) and fill in real values.
# docker-compose.yaml reads these; nothing here should ever be committed.

# Repo path AS SEEN BY THE DOCKER DAEMON. Airflow's scheduler asks the
# Docker daemon to bind-mount this into every one-shot training container
# it launches, and that daemon resolves the path against the host, not
# against the scheduler container's own filesystem.
#   Linux/macOS: the repo's absolute path, e.g. /home/you/walsmart-sales-forecasting
#   Windows + Docker Desktop (WSL2 backend): the /mnt/c/... form, e.g.
HOST_PROJECT_DIR=/mnt/c/python3_10_11/walsmart sales forecasting

# GitHub personal access token with push rights to this repo (Contents:
# read/write is enough). Used only by src/commit_artifacts.py, the last
# step of the m5_full_retrain DAG, to push the post-retrain dvc.lock
# update. Leave blank to have it commit locally inside the container
# without pushing.
GITHUB_TOKEN=

# DVC's own DagsHub credentials are NOT set here -- they live in
# .dvc/config.local (gitignored), which dvc reads automatically.

# MLflow is DagsHub-hosted (tracking server + model registry + UI), not a
# self-managed server -- every DagsHub repo gets one free at
# https://dagshub.com/<owner>/<repo>.mlflow (default baked into
# src/common.py's MLFLOW_TRACKING_URI_DEFAULT; override here only if it
# ever changes). Auth is HTTP basic: the mlflow client reads these two env
# vars automatically, no code needed. PASSWORD is a DagsHub access token
# (Settings -> Tokens on dagshub.com), not your account password -- the
# same kind of token DVC uses, but authenticated independently; this
# doesn't reuse .dvc/config.local's token for you.
MLFLOW_TRACKING_URI=https://dagshub.com/tanmoyghosh704-lang/walmart-mlops-forecasting.mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
